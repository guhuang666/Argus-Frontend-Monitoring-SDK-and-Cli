# Argus 凭据（复制本文件为 .env 后填写）
#
# ⚠️ .env 必须写进宿主项目的 .gitignore，绝不能提交。
# 本文件本身**不含任何真实凭据**，可以提交。

# ── 公钥（可以公开）─────────────────────────────────────────────────────
# 只授权"往这一个项目写事件"，本来就要出现在浏览器代码里。
# 必须带 VITE_ 前缀：Vite 只把 VITE_ 开头的变量内联进前端 bundle。
VITE_ARGUS_KEY=argus_pub_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# ── 私钥（绝不能公开）───────────────────────────────────────────────────
# 用于上传 Sourcemap。**绝不能加 VITE_ 前缀**（加了就会被打进浏览器）。
# 也绝不能出现在任何前端源码里。
ARGUS_SECRET=argus_sec_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
